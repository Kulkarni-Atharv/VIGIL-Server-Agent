# IP address of the PC running the Central Server (check with ipconfig)
SERVER_URL=http://<Server IP>:8000

# TLS certificate verification for the Central Server connection.
# true (default) → verify against system CA bundle
# false          → skip verification (dev only, NEVER in production)
# /path/to/ca.pem → verify against a specific CA file (factory self-signed certs)
SERVER_SSL_VERIFY=true

# Unique name for this Jetson device
JETSON_ID=jetson-01

# Must match the API_KEY in central_server/.env
API_KEY=vigil-secret-key-change-me

# How often (in seconds) to send a heartbeat
HEARTBEAT_INTERVAL=5

# Set to true on non-Jetson hardware (PC/VM) to simulate GPU & temperature
MOCK_JETSON_METRICS=false

# ── Camera feed health (independent of AI inference FPS) ─────────────────────
# A camera is marked DOWN if no frame has been successfully read for this
# many seconds. Tune this to your camera's actual frame-READ cadence — NOT
# your AI inference rate. E.g. if your AI only processes 1 frame every 5s
# but the raw RTSP read loop keeps pulling frames continuously, leave this
# based on the read loop's expected cadence, with generous slack for jitter.
# Shared by both backends below (opencv and deepstream).
CAMERA_STALE_AFTER_SECONDS=30
# Consecutive failed reads before immediately flagging DOWN, without waiting
# for the staleness window above (catches an obviously broken connection fast).
CAMERA_FAIL_THRESHOLD=5
# Delay between reconnect attempts after a read failure — absorbs brief
# network blips without spamming reconnect attempts or false DOWN alerts.
# opencv backend only (DeepStream's nvurisrcbin/uridecodebin handle their
# own internal reconnect).
CAMERA_RECONNECT_DELAY_SECONDS=2

# ── Stream backend ─────────────────────────────────────────────────────────────
# opencv (default) → camera_stream_manager.py, one cv2 thread per camera.
# deepstream        → deepstream_stream_manager.py, one shared GStreamer
#                      pipeline batching all cameras via nvstreammux. Requires
#                      GStreamer + DeepStream Python bindings (pyds) installed
#                      — only valid on a real Jetson with DeepStream, not a
#                      plain dev PC. See that file's docstring before using it;
#                      you'll need to wire your existing nvinfer/tracker/OSD/
#                      sink branch in via its on_source_added callback.
STREAM_BACKEND=opencv

# ── DeepStream nvstreammux tuning (only used when STREAM_BACKEND=deepstream) ──
DS_MUX_WIDTH=1920
DS_MUX_HEIGHT=1080
# Should match (or exceed) the number of cameras this Jetson will be assigned.
DS_MUX_BATCH_SIZE=12
DS_MUX_BATCH_TIMEOUT_USEC=40000

# ── DeepStream inference branch (only used when STREAM_BACKEND=deepstream) ───
# Point this at the SAME nvinfer config .txt your existing standalone
# DeepStream pipeline already uses (model engine path, labels file, etc. all
# live inside that file). Leave blank to run ingestion + health-check only,
# with no detection — a safe first step before pointing at a real model.
DS_INFER_CONFIG_PATH=
# Optional — path to an nvtracker config file (NvDCF/IOU/etc), if you use one.
DS_TRACKER_CONFIG_PATH=
# Draw bounding boxes via nvdsosd — only matters if DS_SINK_TYPE is a visual
# sink (display/file/rtsp). No effect on detection or health logic either way.
DS_ENABLE_OSD=false
# fakesink (default, correct for a headless server agent — detections are
# still extracted and logged via the probe even with nothing rendered) |
# display (needs a screen attached) | file (writes an mp4) | rtsp (basic
# RTP/UDP H264 output for spot-checking, not a full RTSP mount point).
DS_SINK_TYPE=fakesink
DS_SINK_FILE_PATH=/tmp/vigil_deepstream_out.mp4
DS_SINK_RTSP_PORT=8554
# Minimum seconds between detection log lines PER CAMERA (throttling only —
# inference itself still runs on every batch).
DS_DETECTION_LOG_INTERVAL_SECONDS=5

# ── Network (air-gapped deployments) ──────────────────────────────────────────
# Set this to the Jetson's static LAN IP if 8.8.8.8 is unreachable on your network.
# Without this, the agent auto-detects its IP via a UDP trick that requires an
# internet route. On isolated factory LANs this fails and reports 127.0.0.1,
# causing the Central Server to send all commands to localhost (all fail silently).
# JETSON_IP=192.168.1.101
